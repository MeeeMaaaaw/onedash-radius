# Dedicated PAP-only hotspot virtual server. Not WPA-Enterprise/EAP or CHAP.
server onedash {
    listen {
        type = auth
        ipaddr = 0.0.0.0
        port = 1812
    }
    listen {
        type = acct
        ipaddr = 0.0.0.0
        port = 1813
    }
    authorize {
        if (!&User-Name || !&User-Password || !&Calling-Station-Id) {
            reject
        }
        update control {
            Auth-Type := REST
        }
    }
    authenticate {
        Auth-Type REST {
            update control {
                REST-HTTP-Header := "Authorization: Bearer __RADIUS_TOKEN__"
                REST-HTTP-Header += "X-Site-ID: %{client:shortname}"
                REST-HTTP-Header += "X-Nas-IP: %{Packet-Src-IP-Address}"
            }
            onedash_rest
            # REST 200 with reply attributes returns updated; authenticate requires ok.
            if (updated) {
                ok
            }
        }
    }
    accounting {
        update control {
            REST-HTTP-Header := "Authorization: Bearer __RADIUS_TOKEN__"
            REST-HTTP-Header += "X-Site-ID: %{client:shortname}"
            REST-HTTP-Header += "X-Nas-IP: %{Packet-Src-IP-Address}"
        }
        onedash_rest
        if (!(ok || updated)) {
            update control {
                Response-Packet-Type := Do-Not-Respond
            }
        }
    }
}
